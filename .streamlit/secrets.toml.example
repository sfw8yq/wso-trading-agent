# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Community Cloud → App → Settings → Secrets.

# --- email transport (choose ONE) ---
# Option A: Resend (https://resend.com, free tier) — simplest
# RESEND_API_KEY = "re_xxxxxxxxx"
# EMAIL_FROM = "WSO Agent <alerts@yourdomain.com>"   # must be a verified sender/domain in Resend

# Option B: SMTP (e.g. Gmail with an App Password)
# SMTP_HOST = "smtp.gmail.com"
# SMTP_PORT = "587"
# SMTP_USER = "you@gmail.com"
# SMTP_PASS = "xxxx xxxx xxxx xxxx"
# EMAIL_FROM = "you@gmail.com"

# --- shared state (optional but recommended when the GitHub Actions scheduler is used) ---
# WSO_STORE = "github"
# GH_TOKEN = "github_pat_xxx"          # fine-grained token with Contents: read/write on this repo
# GH_REPO = "your-user/wso-trading-agent"
# GH_BRANCH = "main"
# GH_STATE_PATH = "data/state.json"
